# Copie para deploy/.env na VM e preencha. Nunca publique o .env preenchido.

# Dominio HTTPS da API. Sem dominio proprio, use <IP-com-hifens>.sslip.io (ex.: 129-146-10-20.sslip.io).
API_DOMINIO=

# Supabase > Connect > Session pooler (porta 5432, funciona em IPv4).
# Formato JDBC: jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=
DB_USER=postgres.<ref-do-projeto>
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# 64+ caracteres aleatorios: openssl rand -hex 48
JWT_SECRET=
# URL do front (Vercel), somente HTTPS, sem barra final.
CORS_ALLOWED_ORIGINS=https://seu-projeto.vercel.app

# Cria o primeiro admin na primeira subida; depois volte para false.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Gateway de IA (FreeLLMAPI na mesma VM). Chave unificada copiada do painel.
IA_CHAVE_API=
IA_MODELO=auto
IA_TEMPO_LIMITE=45s
# 32 bytes hex: openssl rand -hex 32. Guarde: sem ela as chaves dos provedores nao sao lidas.
FREELLMAPI_CHAVE_CRIPTOGRAFIA=

# Cadastro de professores para o evento.
DEMO_CADASTRO_HABILITADO=false
DEMO_MAXIMO_CADASTROS_POR_IP=10
DEMO_VALIDADE=3d
DEMO_MAXIMO_CONTAS=50

# Ordem de modelos pedida ao gateway: primeiro os mais rapidos e com mais cota gratuita.
IA_MODELOS_CASO=gpt-oss-120b,gpt-oss-20b,nemotron-3-super-120b-a12b,gemini-3.5-flash-lite,ministral-14b-latest
IA_MODELOS_PERGUNTAS=gpt-oss-120b,gpt-oss-20b,nemotron-3-super-120b-a12b,gemini-3.5-flash-lite,ministral-14b-latest
# A trava de simultaneas vale para a plataforma inteira; os limites por minuto e por dia valem por usuario.
IA_MAXIMO_SIMULTANEAS=25
IA_LIMITE_POR_MINUTO=10
IA_LIMITE_POR_DIA=100
